# ── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ── Banco de dados (PostgreSQL gerenciado pelo Supabase) ─
# A autenticação de negócio (JWT/roles) é feita pelo NestJS.
# O Supabase é usado aqui como Postgres gerenciado + storage de arquivos
# (radiografias, documentos). Se no futuro quiser usar o Supabase Auth
# nativo em vez de JWT próprio, isso muda o módulo `auth`, não o resto.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dentalcare
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=dentalcare
DB_SSL=false

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=clinical-files

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# ── Notificações (lembretes de consulta) ─────────────
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
