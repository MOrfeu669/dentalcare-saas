# ── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ── Banco de dados (PostgreSQL local) ────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dentalcare
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123
DB_DATABASE=dentalcare
DB_SSL=false

# ── Armazenamento de arquivos (radiografias, documentos) ──
# Disco local do próprio servidor — sem dependência de nuvem.
STORAGE_LOCAL_PATH=./uploads

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# ── Notificações (lembretes de consulta) ─────────────
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
